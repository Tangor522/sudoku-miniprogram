<view class="root theme-{{colorMode}} page-bg">
  <view wx:if="{{loading}}" class="loading-box"><view class="loading-spinner"></view><view class="loading-text">正在加载对局</view></view>

  <view wx:else class="game-container">
    <view class="battle-head">
      <view class="exit-btn" bindtap="exitBattle">{{gamePhase === 'playing' ? '认输' : '退出对战'}}</view>
      <view class="round-info"><text>{{mode}}</text><text class="round-count">{{totalRounds}} 局</text></view>
      <view class="timer"><view class="timer-dot"></view>{{timerText}}</view>
    </view>

    <view class="players-bar">
      <view class="player-info">
        <image wx:if="{{myInfo.avatarUrl}}" class="player-avatar" src="{{myInfo.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="player-avatar placeholder">我</view>
        <view class="player-meta"><view class="player-name">我</view><view class="player-round">{{gamePhase === 'playing' ? myCurrentRound + '/' + totalRounds + ' 局' : '等待开始'}}</view><view class="player-total">{{myTotalTimeText}}</view></view>
      </view>
      <view class="vs-mark">VS</view>
      <view class="player-info opponent">
        <view class="player-meta"><view class="player-name">{{oppInfo.nickName || '对手'}}</view><view class="player-round">{{gamePhase === 'playing' ? oppCurrentRound + '/' + totalRounds + ' 局' : '等待开始'}}</view><view class="player-total">{{oppTotalTimeText}}</view></view>
        <image wx:if="{{oppInfo.avatarUrl}}" class="player-avatar" src="{{oppInfo.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="player-avatar placeholder">TA</view>
      </view>
    </view>

    <view wx:if="{{gamePhase === 'readying'}}" class="ready-section">
      <view class="ready-card">
        <view class="ready-symbol"><view></view><view></view><view></view><view></view></view>
        <view class="ready-title">准备好了吗？</view>
        <view class="ready-sub">双方确认后同时开始计时</view>
        <view class="ready-vs">
          <view class="ready-player">
            <image wx:if="{{myInfo.avatarUrl}}" class="ready-avatar" src="{{myInfo.avatarUrl}}" mode="aspectFill"></image><view wx:else class="ready-avatar placeholder">我</view>
            <text class="ready-name">我</text><view class="ready-status {{myReady ? 'ready-yes' : 'ready-wait'}}">{{myReady ? '已准备' : '未准备'}}</view>
          </view>
          <view class="ready-divider">VS</view>
          <view class="ready-player">
            <image wx:if="{{oppInfo.avatarUrl}}" class="ready-avatar" src="{{oppInfo.avatarUrl}}" mode="aspectFill"></image><view wx:else class="ready-avatar placeholder">TA</view>
            <text class="ready-name">{{oppInfo.nickName || '对手'}}</text><view class="ready-status {{oppReady ? 'ready-yes' : 'ready-wait'}}">{{oppReady ? '已准备' : '等待中'}}</view>
          </view>
        </view>
        <button wx:if="{{!myReady}}" class="btn-primary ready-btn" bindtap="handleReady">准备开始</button>
        <view wx:else class="ready-waiting-text"><view class="waiting-dot"></view>等待对手准备</view>
      </view>
    </view>

    <block wx:if="{{gamePhase === 'playing'}}">
      <view class="opp-progress-bar">
        <view class="opp-progress-label"><text>{{oppInfo.nickName || '对手'}}的进度</text><text class="opp-progress-round">{{oppCurrentRound}} / {{totalRounds}}</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{oppProgressPercent}}%"></view></view>
        <view class="opp-progress-time">累计 {{oppTotalTimeText}}</view>
      </view>

      <view class="my-grid my-grid-{{mode}}">
        <view class="grid-shell">
          <block wx:for="{{gridRows}}" wx:for-item="row" wx:key="row">
            <view class="grid-row">
              <block wx:for="{{row}}" wx:for-item="cell" wx:key="col">
                <view class="cell-wrap {{cell.borderLeft ? 'border-left' : ''}} {{cell.borderTop ? 'border-top' : ''}}">
                  <view class="cell {{cell.fixed ? 'cell-fixed' : 'cell-input'}} {{cell.error ? 'cell-error' : ''}} {{cell.selected ? 'cell-selected' : ''}}" data-row="{{cell.row}}" data-col="{{cell.col}}" bindtap="selectCell"><text class="cell-text">{{cell.value !== 0 ? cell.value : ''}}</text></view>
                </view>
              </block>
            </view>
          </block>
        </view>
      </view>

      <view class="numpad">
        <view class="numpad-row"><view wx:for="{{numbersRow1}}" wx:key="*this" class="num-btn" data-num="{{item}}" bindtap="onNumberClick">{{item}}</view></view>
        <view class="numpad-row"><view wx:for="{{numbersRow2}}" wx:key="*this" class="num-btn" data-num="{{item}}" bindtap="onNumberClick">{{item}}</view></view>
      </view>
      <button class="submit-btn" bindtap="submitAnswer">提交答案</button>
    </block>

    <view wx:if="{{oppOffline}}" class="offline-tip">对手暂时离线，等待重连 {{reconnectCountdown}} 秒</view>
  </view>

  <view wx:if="{{showFinal}}" class="mask">
    <view class="modal-card animate-pop final-card">
      <view class="result-mark {{finalInfo.result === '胜利' ? 'win' : (finalInfo.result === '平局' ? 'draw' : 'lose')}}">{{finalInfo.result === '胜利' ? '胜' : (finalInfo.result === '平局' ? '平' : '再来')}}</view>
      <view class="modal-kicker">对战结束</view><view class="modal-title">{{finalInfo.result}}</view>
      <view class="final-totals"><view class="final-total"><text>我</text><text class="final-time">{{finalInfo.myTotalText}}</text></view><view class="final-divider"></view><view class="final-total"><text>对手</text><text class="final-time">{{finalInfo.oppTotalText}}</text></view></view>
      <view class="rounds-detail">
        <view class="detail-header"><text class="dh-round">局</text><text class="dh-time">我</text><text class="dh-time">对手</text></view>
        <view wx:for="{{finalInfo.roundsDetail}}" wx:key="round" class="detail-row"><text class="dr-round">{{item.round}}</text><text class="dr-time">{{item.myTimeText}}</text><text class="dr-time">{{item.oppTimeText}}</text></view>
      </view>
      <button class="btn-primary modal-btn" bindtap="goHome">返回首页</button>
    </view>
  </view>
</view>
