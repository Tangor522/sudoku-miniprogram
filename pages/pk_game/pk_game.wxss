/* pages/pk_game/pk_game.wxss */
.root { min-height: 100vh; }
.loading-box { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.loading-text { font-size: 30rpx; color: #999; }

.game-container { padding: 20rpx; max-width: 640rpx; margin: 0 auto; box-sizing: border-box; }

/* 顶栏 */
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.back-btn { background: var(--cell-highlight); color: var(--primary-text); padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }
.round-info { font-size: 34rpx; font-weight: 700; color: var(--primary-text); }
.timer { font-size: 28rpx; font-family: monospace; background: var(--header-bg); padding: 8rpx 20rpx; border-radius: 999rpx; color: var(--primary-text); }

/* 双方信息 */
.players-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; padding: 12rpx 16rpx; background: var(--card-bg); border-radius: 20rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.player-info { display: flex; align-items: center; flex: 1; }
.player-info.left { justify-content: flex-start; }
.player-info.right { justify-content: flex-end; }
.player-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--cell-empty); margin: 0 8rpx; }
.player-avatar.placeholder { display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #999; }
.player-meta { margin: 0 8rpx; }
.player-name { font-size: 24rpx; color: #555; }
.player-total { font-size: 28rpx; font-weight: 700; color: var(--primary-text); font-family: monospace; }
.vs { font-size: 24rpx; font-weight: 700; color: #ccc; }

/* 准备阶段 */
.ready-section { display: flex; justify-content: center; padding: 40rpx 0; }
.ready-card { width: 100%; background: var(--card-bg); border-radius: 32rpx; padding: 48rpx 32rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08); }
.ready-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.ready-title { font-size: 36rpx; font-weight: 700; color: var(--primary-text); margin-bottom: 40rpx; }
.ready-vs { display: flex; align-items: center; justify-content: space-around; width: 100%; margin-bottom: 40rpx; }
.ready-player { display: flex; flex-direction: column; align-items: center; }
.ready-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--cell-empty); margin-bottom: 12rpx; }
.ready-avatar.placeholder { display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #ccc; }
.ready-name { font-size: 26rpx; color: #555; margin-bottom: 8rpx; max-width: 160rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ready-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.ready-yes { background: #d1fae5; color: #059669; }
.ready-wait { background: #f3f4f6; color: #9ca3af; }
.ready-divider { font-size: 36rpx; font-weight: 700; color: #ccc; }
.ready-btn { width: 80%; font-size: 36rpx; padding: 28rpx 0; }
.ready-waiting-text { font-size: 28rpx; color: #999; }

/* 对手进度条（不显示棋盘，防抄袭） */
.opp-section { margin-bottom: 16rpx; }
.opp-progress-bar { background: var(--card-bg); border-radius: 20rpx; padding: 20rpx 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.opp-progress-label { display: flex; justify-content: space-between; font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.opp-progress-round { color: var(--primary-text); font-weight: 700; }
.progress-track { width: 100%; height: 16rpx; background: #f0f0f0; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(to right, var(--primary-from), var(--primary-to)); border-radius: 8rpx; transition: width 0.5s ease; }
.opp-progress-time { font-size: 24rpx; color: #999; margin-top: 8rpx; text-align: right; font-family: monospace; }

/* 我的棋盘 */
.my-grid { background: var(--card-bg); border-radius: 20rpx; padding: 12rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); margin-bottom: 16rpx; }
.grid-row { display: flex; }
.cell-wrap { flex: 1; padding: 3rpx; box-sizing: border-box; }
.cell-wrap.border-left { padding-left: 10rpx; }
.cell-wrap.border-top { padding-top: 10rpx; }
.cell { width: 100%; padding-bottom: 100%; height: 0; position: relative; border: 2rpx solid var(--border-color); border-radius: 10rpx; background: var(--cell-empty); box-sizing: border-box; }
.cell-fixed { background: var(--cell-fixed); }
.cell-error { border-color: var(--error-color); }
.cell-selected { box-shadow: 0 0 0 4rpx var(--primary-solid); }
.cell-text { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; color: var(--primary-text); }
.my-grid-6x6 .cell-text { font-size: 36rpx; }

/* 数字键盘（2行，与单人模式一致） */
.numpad { margin-bottom: 16rpx; }
.numpad-row { display: flex; margin-bottom: 16rpx; }
.numpad-row:last-child { margin-bottom: 0; }
.num-btn { flex: 1; margin: 0 8rpx; height: 140rpx; display: flex; align-items: center; justify-content: center; font-size: 56rpx; font-weight: 700; color: var(--primary-text); background: linear-gradient(to bottom right, var(--cell-highlight), var(--cell-selected)); border-radius: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08); }
.num-btn:active { transform: scale(0.95); }

.submit-btn { width: 100%; font-size: 32rpx; padding: 24rpx 0; }

/* 掉线提示 */
.offline-tip { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.8); color: #fff; padding: 20rpx 40rpx; border-radius: 20rpx; font-size: 28rpx; z-index: 100; }

/* 弹窗 */
.modal-card { width: 600rpx; background: #fff; border-radius: 32rpx; padding: 48rpx 32rpx; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.modal-emoji { font-size: 96rpx; margin-bottom: 16rpx; }
.modal-title { font-size: 40rpx; font-weight: 700; color: var(--primary-text); margin-bottom: 12rpx; }
.modal-title.big { font-size: 48rpx; }
.modal-desc { font-size: 28rpx; color: #666; margin-bottom: 24rpx; }
.round-times { display: flex; margin-bottom: 32rpx; }
.round-time { font-size: 30rpx; font-weight: 700; color: var(--primary-text); margin: 0 24rpx; }
.modal-btn { width: 100%; }

/* 结算弹窗 */
.final-card { width: 640rpx; }
.final-totals { display: flex; margin-bottom: 24rpx; }
.final-total { font-size: 36rpx; font-weight: 700; color: var(--primary-text); margin: 0 32rpx; font-family: monospace; }
.rounds-detail { width: 100%; margin-bottom: 32rpx; }
.detail-header { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid #eee; }
.detail-row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.dh-round, .dr-round { width: 100rpx; text-align: center; font-weight: 700; font-size: 26rpx; color: #555; }
.dh-time, .dr-time { flex: 1; text-align: center; font-size: 26rpx; color: #555; font-family: monospace; }
