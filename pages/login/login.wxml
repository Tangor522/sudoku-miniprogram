<view class="root theme-{{colorMode}} page-bg">
  <view class="login-orb orb-one"></view><view class="login-orb orb-two"></view>
  <view class="login-container">
    <view class="logo">
      <view class="logo-mark"><view></view><view></view><view></view><view></view></view>
      <text class="logo-title">数独小勇士</text>
      <text class="logo-sub">专注思考，每天进步一小格</text>
    </view>

    <view class="login-box panel">
      <view class="panel-title">登录后继续</view>
      <view class="login-desc">{{loginDesc}}</view>
      <button class="btn-primary login-btn" loading="{{logging}}" disabled="{{logging}}" bindtap="handleLogin">{{logging ? '登录中' : (isLocalMode ? '本机体验登录' : '微信快捷登录')}}</button>
      <view wx:if="{{error}}" class="login-error">{{error}}</view>
      <view class="skip-btn" role="button" aria-label="暂不登录，返回体验" hover-class="tap-active" bindtap="continueAsGuest">暂不登录，返回体验</view>
      <view wx:if="{{isLocalMode}}" class="local-tip">当前为本地模式，进度仅保存在本机</view>
    </view>
  </view>
</view>
