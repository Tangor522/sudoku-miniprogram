/* pages/login/login.wxss */
.root { min-height: 100vh; }

.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}
.logo-emoji { font-size: 96rpx; }
.logo-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary-text);
  margin-top: 16rpx;
}

.login-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 56rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}
.login-desc {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 40rpx;
  text-align: center;
}
.login-btn { width: 100%; }
.btn-icon { margin-right: 8rpx; }
.local-tip {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 24rpx;
  text-align: center;
}

.profile-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 56rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}
.profile-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-text);
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  width: 160rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}
.avatar-wrapper::after { border: none; }
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--cell-empty);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.avatar-placeholder { color: #ccc; }
.avatar-tip {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 12rpx;
}

.nick-row {
  width: 100%;
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  border-bottom: 2rpx solid var(--border-color);
  padding-bottom: 16rpx;
}
.nick-label {
  font-size: 30rpx;
  color: #666;
  width: 100rpx;
}
.nick-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.save-btn { width: 100%; margin-top: 48rpx; }
.skip-btn {
  font-size: 26rpx;
  color: #999;
  margin-top: 32rpx;
}

/* 静默登录 loading */
.silent-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.silent-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--cell-highlight);
  border-top: 6rpx solid var(--primary-solid);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.silent-text {
  font-size: 28rpx;
  color: var(--primary-text);
}

.login-container {
  padding: calc(48rpx + env(safe-area-inset-top)) 48rpx calc(48rpx + env(safe-area-inset-bottom));
}
.login-btn, .save-btn {
  min-height: 96rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
