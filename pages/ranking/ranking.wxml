<view class="root theme-{{colorMode}} page-bg">
  <view class="ranking-container">
    <view class="page-intro"><text class="ranking-title">勇士排行</text><text class="ranking-sub">通关越多排名越高，关数相同时用时更短者优先</text></view>

    <view wx:if="{{isLocalMode}}" class="local-card card">
      <view class="cloud-mark"><view class="cloud-dot one"></view><view class="cloud-dot two"></view><view class="cloud-base"></view></view>
      <view class="local-title">排行榜暂不可用</view>
      <view class="local-text">连接在线服务后，即可查看全部玩家排名</view>
      <button class="btn-primary local-btn" bindtap="showCloudTip">我知道了</button>
    </view>

    <view wx:elif="{{loading}}" class="loading-box"><view class="loading-spinner"></view><view class="loading-text">正在加载排行</view></view>
    <view wx:elif="{{error}}" class="error-box"><view class="error-text">{{error}}</view><button class="btn-primary retry-btn" bindtap="loadRanking">重新加载</button></view>

    <block wx:else>
      <view wx:if="{{myRank}}" class="my-rank-card">
        <view><text class="my-rank-label">我的排名</text><text class="my-rank-num">第 {{myRank.rank}} 名</text></view>
        <view class="my-rank-stats">
          <view class="stat-item"><text class="stat-num">{{myRank.totalLevels}}</text><text class="stat-label">通关</text></view>
          <view class="stat-item"><text class="stat-num time">{{myRank.totalTimeText}}</text><text class="stat-label">总用时</text></view>
        </view>
      </view>

      <view class="ranking-board">
        <view class="rank-header"><view class="col-rank">名次</view><view class="col-player">玩家</view><view class="col-levels">关数</view><view class="col-time">总用时</view></view>
        <view wx:if="{{rankings.length === 0}}" class="empty"><view class="empty-rank">—</view><text>还没有排行数据</text><text class="empty-sub">完成第一关，成为首位上榜勇士</text></view>
        <view wx:else class="rank-list">
          <view wx:for="{{rankings}}" wx:key="rank" class="rank-row {{item.isMe ? 'rank-row-me' : ''}}">
            <view class="col-rank"><view class="rank-badge rank-{{item.rank <= 3 ? item.rank : 'normal'}}">{{item.rank}}</view></view>
            <view class="col-player">
              <image wx:if="{{item.avatarUrl}}" class="player-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="player-avatar player-avatar-placeholder"><view></view></view>
              <text class="player-name">{{item.nickName}}</text>
            </view>
            <view class="col-levels">{{item.totalLevels}}</view><view class="col-time">{{item.totalTimeText}}</view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
