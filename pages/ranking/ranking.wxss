.root{min-height:100vh}.ranking-container{max-width:690rpx;margin:0 auto;padding:32rpx 24rpx 64rpx;box-sizing:border-box}.page-intro{padding:0 6rpx;margin-bottom:28rpx;display:flex;flex-direction:column}.ranking-title{font-size:39rpx;color:var(--text-main);font-weight:900}.ranking-sub{max-width:560rpx;font-size:20rpx;line-height:1.55;color:var(--text-muted);margin-top:7rpx}
.empty .empty-sub{font-size:19rpx;color:var(--text-muted);font-weight:500;margin-top:8rpx}
.local-card{padding:52rpx 34rpx 34rpx;display:flex;flex-direction:column;align-items:center}.cloud-mark{width:92rpx;height:76rpx;position:relative}.cloud-dot{position:absolute;border-radius:50%;background:var(--surface-strong)}.cloud-dot.one{width:56rpx;height:56rpx;left:5rpx;top:14rpx}.cloud-dot.two{width:46rpx;height:46rpx;right:5rpx;top:4rpx}.cloud-base{position:absolute;left:4rpx;right:4rpx;bottom:3rpx;height:39rpx;border-radius:22rpx;background:var(--surface-strong)}.local-title{font-size:31rpx;color:var(--text-main);font-weight:900;margin-top:15rpx}.local-text{font-size:22rpx;line-height:1.6;color:var(--text-muted);text-align:center;margin:9rpx 0 29rpx}.local-btn{width:100%}.loading-box,.error-box{padding:90rpx 0;display:flex;flex-direction:column;align-items:center}.loading-spinner{width:52rpx;height:52rpx;border:5rpx solid var(--surface-strong);border-top-color:var(--primary-solid);border-radius:50%;animation:spin .8s linear infinite}.loading-text,.error-text{font-size:23rpx;color:var(--text-muted);margin-top:20rpx}.retry-btn{width:320rpx;margin-top:24rpx}
.my-rank-card{padding:28rpx 30rpx;margin-bottom:18rpx;border-radius:30rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));box-shadow:0 14rpx 32rpx var(--primary-shadow);color:#fff}.my-rank-label,.my-rank-num{display:block}.my-rank-label{font-size:20rpx;opacity:.86}.my-rank-num{font-size:36rpx;font-weight:900;margin-top:4rpx}.my-rank-stats{display:flex;gap:28rpx}.stat-item{display:flex;flex-direction:column;align-items:flex-end}.stat-num{font-size:31rpx;font-weight:900}.stat-num.time{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:25rpx}.stat-label{font-size:18rpx;opacity:.78;margin-top:5rpx}
.ranking-board{border-radius:29rpx;background:rgba(255,255,255,.94);box-shadow:var(--shadow-soft);overflow:hidden}.rank-header,.rank-row{display:flex;align-items:center}.rank-header{height:70rpx;background:var(--surface-soft);color:var(--text-muted);font-size:19rpx;font-weight:750}.rank-row{min-height:84rpx;border-bottom:1rpx solid var(--grid-line);color:var(--text-main);font-size:23rpx}.rank-row:last-child{border-bottom:0}.rank-row-me{background:var(--surface-soft);box-shadow:inset 5rpx 0 0 var(--primary-solid)}.col-rank{width:82rpx;flex:none;text-align:center;display:flex;justify-content:center}.col-player{flex:1;min-width:0;display:flex;align-items:center;padding-left:7rpx;box-sizing:border-box}.col-levels{width:76rpx;flex:none;text-align:center}.col-time{width:126rpx;flex:none;text-align:center}.rank-badge{width:43rpx;height:43rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;background:var(--surface-strong);color:var(--text-muted);font-size:21rpx;font-weight:900}.rank-1{background:#fff0bb;color:#9b6d09}.rank-2{background:#edf0f4;color:#68717d}.rank-3{background:#f5dfcf;color:#9b5d36}.player-avatar{width:50rpx;height:50rpx;flex:none;border-radius:17rpx;background:var(--surface-strong);margin-right:11rpx}.player-avatar-placeholder{display:flex;align-items:center;justify-content:center}.player-avatar-placeholder view{width:21rpx;height:21rpx;border-radius:50%;background:var(--primary-solid);opacity:.28}.player-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-main);font-weight:700}.rank-row .col-levels,.rank-row .col-time{font-weight:800}.rank-row .col-time{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:21rpx}.empty{padding:64rpx 20rpx;display:flex;flex-direction:column;align-items:center;color:var(--text-muted)}.empty-rank{width:70rpx;height:70rpx;border-radius:23rpx;display:flex;align-items:center;justify-content:center;background:var(--surface-strong);color:var(--primary-solid);font-size:30rpx;font-weight:900}.empty text{font-size:27rpx;color:var(--text-main);font-weight:850;margin-top:19rpx}
