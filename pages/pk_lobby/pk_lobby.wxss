.root{min-height:100vh}.lobby-container{max-width:680rpx;margin:0 auto;padding:32rpx 30rpx 60rpx;box-sizing:border-box}.lobby-head{display:flex;align-items:center;margin-bottom:30rpx}.versus-mark{width:72rpx;height:72rpx;flex:none;border-radius:23rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));box-shadow:0 12rpx 28rpx var(--primary-shadow);color:#fff;font-size:23rpx;font-weight:900}.lobby-head>view:last-child{display:flex;flex-direction:column;margin-left:18rpx}.lobby-title{font-size:38rpx;color:var(--text-main);font-weight:900}.lobby-sub{font-size:20rpx;color:var(--text-muted);margin-top:6rpx}.section{margin-bottom:18rpx}.section-label{font-size:25rpx;color:var(--text-main);font-weight:850}.section-label.block,.section-hint{display:block}.section-hint{font-size:19rpx;color:var(--text-muted);margin-top:6rpx}
.opt-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:20rpx}.opt-btn{padding:17rpx 4rpx;border-radius:21rpx;display:flex;flex-direction:column;align-items:center;background:var(--surface-soft);border:2rpx solid transparent;color:var(--text-muted);transition:transform .12s ease}.opt-btn text{font-size:27rpx;font-weight:900}.opt-btn.active{background:var(--surface-strong);border-color:var(--primary-solid);color:var(--primary-solid)}.opt-btn:active,.round-control:active{transform:scale(.94)}
.rounds-section{display:flex;align-items:center;justify-content:space-between}.rounds-input-row{display:flex;align-items:center}.round-control{width:58rpx;height:58rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:var(--surface-strong);color:var(--primary-solid);font-size:32rpx;font-weight:800}.rounds-input{width:70rpx;text-align:center;font-size:39rpx;font-weight:900;color:var(--text-main)}.error-tip{padding:18rpx 22rpx;border-radius:18rpx;background:var(--error-bg);color:var(--error-color);font-size:23rpx;text-align:center;margin-bottom:18rpx}
.matching-box{padding:54rpx 34rpx;display:flex;flex-direction:column;align-items:center}.matching-spinner{width:54rpx;height:54rpx;border:5rpx solid var(--surface-strong);border-top-color:var(--primary-solid);border-radius:50%;animation:spin .8s linear infinite}.matching-text{font-size:31rpx;color:var(--text-main);font-weight:850;margin-top:25rpx}.matching-sub{font-size:21rpx;color:var(--text-muted);margin-top:8rpx}.room-code-display{margin:27rpx 0 5rpx;font-size:52rpx;color:var(--primary-solid);font-weight:900;letter-spacing:10rpx}.cancel-btn{width:100%;margin-top:28rpx}
.actions{margin-top:8rpx}.action-btn{width:100%}.friend-divider{display:flex;align-items:center;margin:28rpx 4rpx 20rpx}.friend-divider view{height:1rpx;flex:1;background:var(--border-color)}.friend-divider text{font-size:19rpx;color:var(--text-muted);margin:0 18rpx}.join-input-row{padding:4rpx;border-radius:25rpx;background:rgba(255,255,255,.94);box-shadow:var(--shadow-soft)}.join-input{height:88rpx;text-align:center;font-size:29rpx;letter-spacing:5rpx;color:var(--text-main)}.action-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.action-btn-half{width:100%;margin:0;font-size:27rpx}
.room-panel{padding:45rpx 34rpx 34rpx;display:flex;flex-direction:column;align-items:center}.room-ready-mark{width:82rpx;height:82rpx;border-radius:27rpx;display:flex;align-items:center;justify-content:center;background:var(--surface-strong)}.room-ready-mark view{width:32rpx;height:18rpx;border-left:6rpx solid var(--primary-solid);border-bottom:6rpx solid var(--primary-solid);transform:rotate(-45deg) translate(2rpx,-3rpx)}.room-panel-title{font-size:31rpx;color:var(--text-main);font-weight:900;margin-top:23rpx}.room-code-big{font-size:62rpx;color:var(--primary-solid);font-weight:900;letter-spacing:11rpx;margin-top:18rpx}.room-tip{font-size:22rpx;color:var(--text-muted);text-align:center;margin:11rpx 0 28rpx}.room-btn{width:100%}.close-room-btn{margin-top:14rpx}
.opt-btn .opt-name{font-size:18rpx;font-weight:500;margin-top:5rpx}

.join-input{box-sizing:border-box}
@media (max-width:360px){
  .lobby-container{padding-left:20rpx;padding-right:20rpx}
  .section{padding-left:22rpx;padding-right:22rpx}
  .opt-btn text{font-size:24rpx}
  .action-row{gap:10rpx}
  .action-btn-half{font-size:24rpx;padding-left:6rpx;padding-right:6rpx}
  .room-code-big{font-size:54rpx;letter-spacing:8rpx}
}