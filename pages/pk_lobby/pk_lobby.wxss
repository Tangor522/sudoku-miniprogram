/* pages/pk_lobby/pk_lobby.wxss */
.root { min-height: 100vh; }
.lobby-container { padding: 32rpx; max-width: 640rpx; margin: 0 auto; box-sizing: border-box; }

.lobby-title { font-size: 48rpx; font-weight: 700; color: var(--primary-text); text-align: center; margin-bottom: 40rpx; }

.section { margin-bottom: 24rpx; }
.section-label { font-size: 28rpx; font-weight: 700; color: #555; margin-bottom: 20rpx; }

/* 模式选择按钮 */
.opt-row { display: flex; }
.opt-btn {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 20rpx; font-size: 30rpx; font-weight: 700;
  background: #f0f0f0; color: #888; margin-right: 16rpx;
}
.opt-btn:last-child { margin-right: 0; }
.opt-btn.active { background: linear-gradient(to right, var(--primary-from), var(--primary-to)); color: #fff; }

/* 局数输入 */
.rounds-input-row { display: flex; align-items: center; justify-content: center; }
.rounds-minus, .rounds-plus {
  width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700; color: #fff;
  background: linear-gradient(to right, var(--primary-from), var(--primary-to));
}
.rounds-minus:active, .rounds-plus:active { transform: scale(0.92); }
.rounds-input {
  width: 120rpx; text-align: center; font-size: 56rpx; font-weight: 700; color: var(--primary-text);
  margin: 0 24rpx; border-bottom: 4rpx solid var(--border-color); padding-bottom: 8rpx;
}
.rounds-unit { font-size: 32rpx; color: #888; }

.error-tip { color: #ef4444; font-size: 26rpx; text-align: center; margin-bottom: 16rpx; }

.matching-box { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0; }
.matching-spinner {
  width: 64rpx; height: 64rpx; border: 6rpx solid var(--cell-highlight);
  border-top: 6rpx solid var(--primary-solid); border-radius: 50%;
  animation: spin 0.8s linear infinite; margin-bottom: 24rpx;
}
@keyframes spin { 0% { transform: rotate(0); } 100% { transform: rotate(360deg); } }
.matching-text { font-size: 30rpx; color: var(--primary-text); margin-bottom: 16rpx; }
.room-code-display { font-size: 40rpx; font-weight: 700; color: var(--primary-solid); margin-bottom: 32rpx; }
.cancel-btn { width: 320rpx; }

.actions { display: flex; flex-direction: column; }
.action-btn { width: 100%; font-size: 36rpx; margin-bottom: 24rpx; padding: 32rpx 0; }
.action-row { display: flex; }
.action-btn-half { flex: 1; margin: 0 8rpx; font-size: 30rpx; padding: 24rpx 0; }
.join-input-row { margin-top: 16rpx; }
.join-input {
  width: 100%; text-align: center; font-size: 40rpx; letter-spacing: 16rpx; font-weight: 700;
  padding: 24rpx 0; border: 4rpx dashed var(--border-color); border-radius: 20rpx; color: var(--primary-text);
}

.room-panel { display: flex; flex-direction: column; align-items: center; padding: 48rpx 32rpx; }
.room-panel-title { font-size: 32rpx; color: #666; margin-bottom: 24rpx; }
.room-code-big { font-size: 80rpx; font-weight: 700; color: var(--primary-solid); letter-spacing: 16rpx; margin-bottom: 24rpx; }
.room-tip { font-size: 26rpx; color: #999; margin-bottom: 32rpx; text-align: center; }
.close-room-btn { width: 100%; margin-top: 16rpx; }
