.root{min-height:100vh}.stats-container{max-width:680rpx;margin:auto;padding:calc(34rpx + env(safe-area-inset-top)) 30rpx 60rpx;box-sizing:border-box}.stats-head{display:flex;align-items:center;justify-content:space-between;text-align:center}.back,.head-space{width:72rpx}.back{height:72rpx;border-radius:24rpx;background:rgba(255,255,255,.8);box-shadow:var(--shadow-soft);display:flex;align-items:center;justify-content:center;font-size:54rpx;color:var(--text-main)}.eyebrow,.stats-title{display:block}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:var(--text-muted)}.stats-title{font-size:38rpx;font-weight:900;color:var(--text-main);margin-top:4rpx}.mode-tabs{display:flex;padding:7rpx;margin:35rpx 0 24rpx;border-radius:25rpx;background:rgba(255,255,255,.62)}.mode-tab{flex:1;padding:17rpx;text-align:center;border-radius:20rpx;color:var(--text-muted);font-size:25rpx;font-weight:800}.mode-tab.active{background:#fff;color:var(--primary-solid);box-shadow:var(--shadow-soft)}.summary-card{padding:32rpx;border-radius:34rpx;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));box-shadow:0 15rpx 35rpx var(--primary-shadow);display:flex;align-items:center;justify-content:space-between;color:#fff}.summary-label,.summary-value{display:block}.summary-label{font-size:22rpx;opacity:.83}.summary-value{font-size:52rpx;font-weight:900;margin-top:5rpx}.summary-value text{font-size:23rpx}.summary-mark{width:78rpx;height:78rpx;border-radius:28rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:42rpx}.list-head{display:flex;justify-content:space-between;margin:34rpx 8rpx 18rpx;color:var(--text-muted);font-size:21rpx}.record-list{border-radius:32rpx;background:rgba(255,255,255,.88);box-shadow:var(--shadow-soft);overflow:hidden}.record-row{display:flex;align-items:center;padding:23rpx 24rpx;border-bottom:1rpx solid var(--grid-line)}.record-row:last-child{border:0}.level-badge{width:62rpx;height:62rpx;border-radius:21rpx;background:var(--cell-peer);color:var(--primary-solid);font-size:27rpx;font-weight:900;display:flex;align-items:center;justify-content:center}.record-copy{flex:1;margin-left:18rpx}.record-title,.record-date{display:block}.record-title{font-size:26rpx;color:var(--text-main);font-weight:850}.record-date{font-size:19rpx;color:var(--text-muted);margin-top:5rpx}.record-time{font-family:monospace;font-size:27rpx;color:var(--text-main);font-weight:800}.empty{padding:75rpx 35rpx;border-radius:34rpx;background:rgba(255,255,255,.85);box-shadow:var(--shadow-soft);display:flex;flex-direction:column;align-items:center;text-align:center}.empty-mark{width:100rpx;height:100rpx;border-radius:36rpx;background:var(--cell-peer);color:var(--primary-solid);font-size:49rpx;display:flex;align-items:center;justify-content:center}.empty-title{font-size:30rpx;color:var(--text-main);font-weight:900;margin-top:25rpx}.empty-sub{font-size:22rpx;color:var(--text-muted);line-height:1.7;margin:10rpx 0 30rpx}.start-button{width:100%;height:90rpx;border-radius:28rpx;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));color:#fff;font-size:29rpx;font-weight:850;box-shadow:0 12rpx 28rpx var(--primary-shadow)}.start-button::after{border:0}.start-button.bottom{margin-top:26rpx}
