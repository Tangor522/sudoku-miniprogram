.root{min-height:100vh}.stats-container{max-width:680rpx;margin:auto;padding:32rpx 30rpx 64rpx;box-sizing:border-box}.page-intro{display:flex;flex-direction:column}.page-title{font-size:39rpx;color:var(--text-main);font-weight:900}.page-sub{font-size:21rpx;color:var(--text-muted);margin-top:7rpx}.mode-tabs{display:flex;padding:6rpx;margin:28rpx 0 20rpx;border-radius:23rpx;background:rgba(255,255,255,.68)}.mode-tab{flex:1;padding:16rpx;text-align:center;border-radius:18rpx;color:var(--text-muted);font-size:24rpx;font-weight:800}.mode-tab.active{background:#fff;color:var(--primary-solid);box-shadow:var(--shadow-soft)}
.summary-card{padding:31rpx 32rpx;border-radius:31rpx;display:flex;align-items:center;justify-content:space-between;color:#fff;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));box-shadow:0 14rpx 32rpx var(--primary-shadow)}.summary-label,.summary-value{display:block}.summary-label{font-size:21rpx;opacity:.88}.summary-value{font-size:52rpx;font-weight:900;margin-top:6rpx}.summary-value text{font-size:22rpx;margin-left:7rpx}.summary-chart{width:80rpx;height:80rpx;padding:18rpx;gap:6rpx;border-radius:26rpx;display:flex;align-items:flex-end;justify-content:center;background:rgba(255,255,255,.17);box-sizing:border-box}.summary-chart view{width:8rpx;border-radius:4rpx;background:#fff}.summary-chart view:nth-child(1){height:19rpx;opacity:.65}.summary-chart view:nth-child(2){height:31rpx;opacity:.8}.summary-chart view:nth-child(3){height:43rpx}
.list-head{display:flex;justify-content:space-between;margin:31rpx 8rpx 16rpx;color:var(--text-muted);font-size:20rpx}.record-list{border-radius:29rpx;background:rgba(255,255,255,.94);box-shadow:var(--shadow-soft);overflow:hidden}.record-row{display:flex;align-items:center;padding:22rpx 23rpx;border-bottom:1rpx solid var(--grid-line)}.record-row:last-child{border:0}.level-badge{width:58rpx;height:58rpx;flex:none;border-radius:19rpx;display:flex;align-items:center;justify-content:center;background:var(--surface-strong);color:var(--primary-solid);font-size:25rpx;font-weight:900}.record-copy{flex:1;min-width:0;margin-left:17rpx}.record-title,.record-date{display:block}.record-title{font-size:25rpx;color:var(--text-main);font-weight:850}.record-date{font-size:18rpx;color:var(--text-muted);margin-top:5rpx}.record-time{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:25rpx;color:var(--text-main);font-weight:800}
.empty{padding:62rpx 34rpx 36rpx;border-radius:31rpx;display:flex;flex-direction:column;align-items:center;text-align:center;background:rgba(255,255,255,.92);box-shadow:var(--shadow-soft)}.empty-board{width:92rpx;height:92rpx;padding:17rpx;border-radius:29rpx;display:grid;grid-template-columns:1fr 1fr;gap:7rpx;background:var(--surface-strong);box-sizing:border-box}.empty-board view{border-radius:5rpx;background:var(--primary-solid);opacity:.22}.empty-board view:first-child,.empty-board view:last-child{opacity:.65}.empty-title{font-size:29rpx;color:var(--text-main);font-weight:900;margin-top:23rpx}.empty-sub{font-size:21rpx;color:var(--text-muted);line-height:1.65;margin:10rpx 0 28rpx}.start-button{width:100%;height:92rpx;border:0;border-radius:27rpx;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));color:#fff;font-size:29rpx;font-weight:850;box-shadow:0 12rpx 28rpx var(--primary-shadow)}.start-button::after{border:0}.start-button.bottom{margin-top:24rpx}

.stats-container{padding-bottom:calc(72rpx + env(safe-area-inset-bottom))}
.page-sub,.summary-label,.empty-sub{font-size:25rpx}
.mode-tab{min-height:82rpx;display:flex;align-items:center;justify-content:center;font-size:27rpx}
.list-head{font-size:23rpx}
.record-date{font-size:22rpx}
.record-row{min-height:104rpx}
@media (max-width:360px){
  .stats-container{padding-left:20rpx;padding-right:20rpx}
  .summary-card{padding-left:24rpx;padding-right:24rpx}
  .record-row{padding-left:18rpx;padding-right:18rpx}
  .record-time{font-size:23rpx}
}

.stats-container{width:100%;max-width:430px;padding-left:var(--page-gutter);padding-right:var(--page-gutter)}
.page-title,.summary-value{font-size:var(--font-xl)}
.page-sub,.summary-label,.empty-sub,.record-date,.list-head{font-size:var(--font-sm)}
.mode-tab,.record-title,.record-time,.empty-title{font-size:var(--font-md)}
.summary-value text,.level-badge,.start-button{font-size:var(--font-md)}
.mode-tab,.start-button{min-height:var(--touch-min)}
.mode-tabs,.record-row,.summary-card{width:100%;min-width:0}
.summary-chart{width:var(--icon-md);height:var(--icon-md)}
.record-time{flex:none;white-space:nowrap}
