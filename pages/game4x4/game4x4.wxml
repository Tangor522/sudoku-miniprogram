<view class="root theme-{{colorMode}} page-bg">
  <view class="ambient ambient-one"></view><view class="ambient ambient-two"></view>
  <view class="game-container {{sizeClass}}">
    <view class="topbar">
      <view class="icon-button" bindtap="goHome">‹</view>
      <view class="level-block"><text class="eyebrow">{{modeTitle}}挑战</text><text class="level-text">第 {{currentLevel}} 关</text></view>
      <view class="timer"><text class="timer-dot"></text>{{timerText}}</view>
    </view>
    <view class="progress-track"><view class="progress-fill" style="width: {{currentLevel}}%"></view></view>

    <button wx:if="{{!gameStarted}}" class="start-game-btn" bindtap="handleStart">开始游戏</button>

    <view class="board-card">
      <view class="grid">
        <block wx:for="{{gridRows}}" wx:for-item="row" wx:key="index">
          <view class="grid-row">
            <block wx:for="{{row}}" wx:for-item="cell" wx:key="col">
              <view class="cell-wrap {{cell.borderLeft ? 'border-left' : ''}} {{cell.borderTop ? 'border-top' : ''}}">
                <view class="cell {{cell.fixed ? 'cell-fixed' : 'cell-input'}} {{cell.error ? 'cell-error' : ''}} {{cell.selected ? 'cell-selected' : ''}}"
                  data-row="{{cell.row}}" data-col="{{cell.col}}" bindtap="selectCell">
                  <text class="cell-text">{{cell.value || ''}}</text>
                </view>
              </view>
            </block>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{gameStarted}}" class="numpad"><view wx:for="{{numberRows}}" wx:for-item="numberRow" wx:key="index" class="numpad-row"><view wx:for="{{numberRow}}" wx:key="*this" class="num-btn" data-num="{{item}}" bindtap="onNumberClick">{{item}}</view></view></view>
    <view wx:if="{{gameStarted}}" class="action-row"><button class="submit-btn" bindtap="checkAnswer">检查答案 <text>→</text></button><button class="reset-button" bindtap="resetGame">重置</button></view>
  </view>

  <view wx:if="{{showResult}}" class="mask">
    <view class="modal-card animate-pop">
      <block wx:if="{{resultStatus === 'success'}}">
        <view class="result-badge success">✓</view><view class="modal-kicker">挑战完成</view>
        <view class="modal-title">太棒了，小勇士！</view>
        <view class="result-time">{{timerText}}</view><view class="modal-desc">第 {{currentLevel}} 关已经收入你的成长记录</view>
        <button class="submit-btn modal-btn" bindtap="nextLevel">继续下一关</button>
      </block>
      <block wx:else>
        <view class="result-badge error">!</view><view class="modal-kicker">再检查一下</view>
        <view class="modal-title">还有空格或冲突</view><view class="modal-desc">红色标记会告诉你需要留意的位置</view>
        <button class="secondary-button modal-btn" bindtap="closeResult">返回棋盘</button>
      </block>
    </view>
  </view>
  <view wx:if="{{showCongrats}}" class="mask"><view class="modal-card animate-pop">
    <view class="result-badge success">★</view><view class="modal-kicker">全部完成</view><view class="modal-title">真正的数独小勇士</view>
    <view class="modal-desc">你完成了 {{modeTitle}} 的全部 100 关</view><button class="submit-btn modal-btn" bindtap="closeCongrats">荣耀返回</button>
  </view></view>
</view>
