.root{min-height:100vh;position:relative;overflow:hidden}.glow{position:fixed;border-radius:50%;opacity:.42;filter:blur(20rpx);pointer-events:none}.glow-one{width:420rpx;height:420rpx;right:-220rpx;top:-150rpx;background:var(--accent-soft)}.glow-two{width:320rpx;height:320rpx;left:-220rpx;top:720rpx;background:var(--secondary-soft)}
.home-container{max-width:700rpx;margin:auto;padding:30rpx 28rpx 64rpx;position:relative;z-index:1;box-sizing:border-box}.header{display:flex;align-items:center;margin-bottom:30rpx}.brand-mark{width:72rpx;height:72rpx;padding:12rpx;border-radius:23rpx;display:grid;grid-template-columns:1fr 1fr;gap:5rpx;box-sizing:border-box;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));box-shadow:0 12rpx 28rpx var(--primary-shadow)}.brand-mark view{border-radius:4rpx;background:rgba(255,255,255,.95)}.brand-mark view:nth-child(2),.brand-mark view:nth-child(3){opacity:.55}.brand-copy{flex:1;display:flex;flex-direction:column;margin-left:17rpx}.brand-title{font-size:36rpx;line-height:1.15;color:var(--text-main);font-weight:900}.brand-eyebrow{font-size:20rpx;color:var(--text-muted);margin-top:7rpx;letter-spacing:1rpx}.avatar-wrap{position:relative}.avatar{width:70rpx;height:70rpx;border-radius:23rpx;border:4rpx solid rgba(255,255,255,.9);box-shadow:var(--shadow-soft);box-sizing:border-box}.avatar-text{display:flex;align-items:center;justify-content:center;background:var(--surface-strong);color:var(--primary-solid);font-size:29rpx;font-weight:900}.online-dot{position:absolute;right:-2rpx;bottom:-1rpx;width:15rpx;height:15rpx;border-radius:50%;background:var(--success-color);border:4rpx solid #fff}
.hero-card{min-height:258rpx;padding:38rpx 32rpx;border-radius:36rpx;display:flex;align-items:center;position:relative;overflow:hidden;background:rgba(255,255,255,.94);border:1rpx solid rgba(255,255,255,.95);box-shadow:var(--shadow-card);box-sizing:border-box}.hero-copy{min-width:0;flex:1;display:flex;flex-direction:column;position:relative;z-index:1}.hero-kicker{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:22rpx;color:var(--primary-solid);font-weight:750}.hero-title{font-size:42rpx;line-height:1.25;color:var(--text-main);font-weight:900;margin-top:14rpx}.hero-sub{max-width:340rpx;font-size:21rpx;line-height:1.6;color:var(--text-muted);margin-top:15rpx}.hero-board{width:164rpx;height:164rpx;flex:none;margin-left:16rpx;padding:10rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:7rpx;border-radius:30rpx;background:var(--surface-soft);transform:rotate(4deg);box-sizing:border-box}.hero-cell{border-radius:9rpx;background:#fff;box-shadow:inset 0 0 0 1rpx var(--border-color)}.hero-cell.active{background:linear-gradient(135deg,var(--primary-from),var(--primary-to));box-shadow:none}
.section-head{margin:38rpx 4rpx 20rpx;display:flex;align-items:flex-end;justify-content:space-between}.section-title{font-size:31rpx;color:var(--text-main);font-weight:900}.section-sub{font-size:19rpx;color:var(--text-muted)}.tools-head{margin-top:32rpx;margin-bottom:16rpx}.mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.mode-card{min-height:230rpx;padding:25rpx;border-radius:30rpx;display:flex;flex-direction:column;background:rgba(255,255,255,.94);border:1rpx solid rgba(255,255,255,.9);box-shadow:var(--shadow-soft);box-sizing:border-box}.mode-nine{grid-column:1/3;min-height:190rpx}.mode-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.mode-icon{height:54rpx;min-width:68rpx;padding:0 12rpx;border-radius:17rpx;display:flex;align-items:center;justify-content:center;background:var(--surface-strong);color:var(--primary-solid);font-size:23rpx;font-weight:900;box-sizing:border-box}.difficulty{padding:7rpx 14rpx;border-radius:999rpx;font-size:18rpx;font-weight:750}.easy{background:#e5f5ed;color:#2b8762}.medium{background:#fff3d9;color:#9a6b17}.hard{background:#eee8f8;color:#6e5797}.mode-title{font-size:30rpx;color:var(--text-main);font-weight:900}.mode-desc{font-size:20rpx;color:var(--text-muted);margin-top:8rpx}.mode-action{margin-top:auto;padding-top:18rpx;color:var(--primary-solid);font-size:22rpx;font-weight:800}.mode-action::after{content:'›';margin-left:8rpx;font-size:29rpx;line-height:0}
.quick-row{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.quick-card,.pk-card{display:flex;align-items:center;background:rgba(255,255,255,.94);border:1rpx solid rgba(255,255,255,.9);box-shadow:var(--shadow-soft)}.quick-card{min-width:0;padding:22rpx 18rpx;border-radius:28rpx}.quick-icon{width:56rpx;height:56rpx;flex:none;border-radius:18rpx;display:flex;align-items:flex-end;justify-content:center;background:var(--surface-strong);box-sizing:border-box}.chart-icon{gap:5rpx;padding:13rpx 11rpx}.medal-icon{align-items:center}.medal-icon view{width:28rpx;height:28rpx;border:4rpx solid var(--primary-solid);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--primary-solid);font-size:17rpx;font-weight:900}.quick-copy{min-width:0;margin-left:14rpx}.quick-title,.quick-sub{display:block}.quick-title{font-size:23rpx;color:var(--text-main);font-weight:850;white-space:nowrap}.quick-sub{font-size:18rpx;color:var(--text-muted);margin-top:5rpx;white-space:nowrap}.pk-card{margin-top:16rpx;padding:22rpx;border-radius:28rpx}.pk-icon{width:58rpx;height:58rpx;flex:none;border-radius:19rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));color:#fff;font-size:19rpx;font-weight:900;letter-spacing:-1rpx}.pk-copy{flex:1;min-width:0;margin-left:16rpx}.chevron{width:13rpx;height:13rpx;border-top:3rpx solid var(--text-faint);border-right:3rpx solid var(--text-faint);transform:rotate(45deg);margin-right:7rpx}
.theme-bar{margin-top:22rpx;padding:20rpx 22rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.68)}.theme-label,.theme-value{display:block}.theme-label{font-size:21rpx;color:var(--text-main);font-weight:800}.theme-value{font-size:17rpx;color:var(--text-muted);margin-top:4rpx}.theme-options{display:flex;gap:10rpx}.theme-choice{width:48rpx;height:48rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center}.theme-choice.active{background:#fff;box-shadow:var(--shadow-soft)}.theme-dot{width:24rpx;height:24rpx;border-radius:50%}.pink{background:#df3f8b}.green{background:#26986a}.amber{background:#c98a12}
.chart-icon>view{width:7rpx;border-radius:4rpx;background:var(--primary-solid)}.chart-icon>view:nth-child(1){height:14rpx}.chart-icon>view:nth-child(2){height:24rpx}.chart-icon>view:nth-child(3){height:32rpx}
.mode-card,.quick-card,.pk-card,.avatar-wrap,.theme-choice{transition:transform .12s ease,opacity .12s ease}.mode-card:active,.quick-card:active,.pk-card:active,.avatar-wrap:active,.theme-choice:active{transform:scale(.97);opacity:.9}
.guest-dot{background:var(--text-faint)}

@media (max-width:360px){
  .home-container{padding-left:20rpx;padding-right:20rpx}
  .brand-eyebrow{display:none}
  .hero-card{padding-left:26rpx;padding-right:22rpx}
  .hero-title{font-size:38rpx}
  .hero-board{width:142rpx;height:142rpx}
  .section-head{align-items:flex-start;flex-direction:column;gap:6rpx}
  .quick-row{grid-template-columns:1fr}
}
