<view class="root theme-{{colorMode}} page-bg">
  <view class="ambient ambient-one"></view><view class="ambient ambient-two"></view>
  <view class="game-container {{sizeClass}}">
    <view class="game-head">
      <view class="level-copy">
        <text class="mode-label">{{modeTitle}}挑战</text>
        <text class="level-text">第 {{currentLevel}} 关</text>
      </view>
      <view class="timer"><view class="timer-dot"></view><text>{{timerText}}</text></view>
    </view>
    <view class="progress-track"><view class="progress-fill" style="width: {{currentLevel}}%"></view></view>

    <button wx:if="{{!gameStarted}}" class="start-game-btn" bindtap="handleStart">开始游戏</button>

    <view class="board-card">
      <view class="grid">
        <block wx:for="{{gridRows}}" wx:for-item="row" wx:key="index">
          <view class="grid-row">
            <block wx:for="{{row}}" wx:for-item="cell" wx:key="col">
              <view class="cell-wrap {{cell.borderLeft ? 'border-left' : ''}} {{cell.borderTop ? 'border-top' : ''}}">
                <view class="cell {{cell.fixed ? 'cell-fixed' : 'cell-input'}} {{cell.error ? 'cell-error' : ''}} {{cell.selected ? 'cell-selected' : ''}}" role="button" aria-label="第 {{cell.row + 1}} 行第 {{cell.col + 1}} 列，{{cell.fixed ? '固定数字 ' + cell.value : (cell.value ? '已填 ' + cell.value : '空格')}}"
                  data-row="{{cell.row}}" data-col="{{cell.col}}" bindtap="selectCell">
                  <text class="cell-text">{{cell.value || ''}}</text>
                </view>
              </view>
            </block>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{gameStarted}}" class="numpad">
      <view wx:for="{{numberRows}}" wx:for-item="numberRow" wx:key="index" class="numpad-row">
        <view wx:for="{{numberRow}}" wx:key="*this" class="num-btn" role="button" aria-label="填入数字 {{item}}" hover-class="tap-active" data-num="{{item}}" bindtap="onNumberClick">{{item}}</view>
      </view>
    </view>
    <view wx:if="{{gameStarted}}" class="game-actions">
      <button class="undo-btn" disabled="{{!canUndo}}" bindtap="undoLast">退回</button>
      <button class="submit-btn" bindtap="checkAnswer">提交答案</button>
    </view>
  </view>

  <view wx:if="{{showResult}}" class="mask">
    <view class="modal-card animate-pop">
      <view class="result-badge success"><view class="checkmark"></view></view>
      <view class="modal-kicker">挑战完成</view>
      <view class="modal-title">做得很好</view>
      <view class="result-time"><text>{{timerMain}}</text><text class="result-time-dot">.</text><text class="result-time-tenths">{{timerTenths}}</text></view>
      <view class="modal-desc">第 {{currentLevel}} 关已记录，继续保持专注</view>
      <button class="submit-btn modal-btn" bindtap="nextLevel">继续下一关</button>
    </view>
  </view>
  <view wx:if="{{showCongrats}}" class="mask">
    <view class="modal-card animate-pop">
      <view class="result-badge complete">100</view>
      <view class="modal-kicker">全部完成</view>
      <view class="modal-title">完成全部挑战</view>
      <view class="modal-desc">你已通过{{modeTitle}}的全部 100 关</view>
      <button class="submit-btn modal-btn" bindtap="closeCongrats">返回首页</button>
    </view>
  </view>
</view>
