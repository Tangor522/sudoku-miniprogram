.root{min-height:100vh;position:relative;overflow:hidden}.ambient{position:fixed;border-radius:50%;filter:blur(14rpx);opacity:.42;pointer-events:none}.ambient-one{width:340rpx;height:340rpx;right:-170rpx;top:-130rpx;background:var(--accent-soft)}.ambient-two{width:270rpx;height:270rpx;left:-160rpx;bottom:80rpx;background:var(--secondary-soft)}
.game-container{width:100%;max-width:700rpx;min-height:100vh;margin:0 auto;padding:26rpx 28rpx 52rpx;box-sizing:border-box;position:relative;z-index:1}.game-head{display:flex;align-items:center;justify-content:space-between}.level-copy{display:flex;flex-direction:column}.mode-label{font-size:21rpx;color:var(--text-muted);letter-spacing:2rpx}.level-text{font-size:38rpx;color:var(--text-main);font-weight:900;margin-top:4rpx}.timer{min-width:150rpx;height:64rpx;padding:0 17rpx;border-radius:21rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.84);box-shadow:var(--shadow-soft);color:var(--text-main);font-size:25rpx;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;box-sizing:border-box}.timer-dot{width:9rpx;height:9rpx;border-radius:50%;background:var(--primary-solid);margin-right:9rpx}.progress-track{height:7rpx;margin:22rpx 0 24rpx;border-radius:999rpx;background:rgba(255,255,255,.8);overflow:hidden}.progress-fill{height:100%;min-width:7rpx;border-radius:inherit;background:linear-gradient(90deg,var(--primary-from),var(--primary-to));transition:width .35s ease}
.start-game-btn,.submit-btn{width:100%;height:98rpx;border:0;border-radius:28rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--primary-from),var(--primary-to));color:#fff;font-size:31rpx;font-weight:850;box-shadow:0 13rpx 30rpx var(--primary-shadow)}.start-game-btn{margin-bottom:24rpx}.start-game-btn::after,.submit-btn::after{border:0}.start-game-btn:active,.submit-btn:active{transform:scale(.98)}
.board-card{padding:16rpx;border-radius:30rpx;background:rgba(255,255,255,.95);border:1rpx solid rgba(255,255,255,.96);box-shadow:var(--shadow-card)}.grid{border:3rpx solid var(--board-line);border-radius:12rpx;overflow:hidden;background:var(--board-line)}.grid-row{display:flex}.cell-wrap{flex:1;box-sizing:border-box;border-right:1rpx solid var(--grid-line);border-bottom:1rpx solid var(--grid-line);background:var(--cell-bg)}.grid-row:last-child .cell-wrap{border-bottom:0}.cell-wrap:last-child{border-right:0}.cell-wrap.border-left{border-left:3rpx solid var(--board-line)}.cell-wrap.border-top{border-top:3rpx solid var(--board-line)}.cell{width:100%;height:0;padding-bottom:100%;position:relative;background:var(--cell-bg)}.cell-fixed{background:var(--cell-fixed)}.cell-selected{box-shadow:inset 0 0 0 4rpx var(--primary-solid);z-index:2}.cell-error{background:var(--error-bg)}.cell-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:46rpx;font-weight:750;color:var(--primary-solid)}.cell-fixed .cell-text{color:#111;font-weight:850}.cell-error .cell-text{color:var(--error-color)}.size-6 .cell-text{font-size:38rpx}.size-9 .board-card{padding:10rpx;border-radius:24rpx}.size-9 .grid{border-radius:7rpx}.size-9 .cell-text{font-size:28rpx}
.numpad{margin:24rpx -7rpx 20rpx}.numpad-row{display:flex;justify-content:center;margin-bottom:13rpx}.numpad-row:last-child{margin-bottom:0}.num-btn{flex:1;height:116rpx;margin:0 7rpx;border-radius:25rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.96);border:1rpx solid rgba(255,255,255,.95);box-shadow:var(--shadow-soft);color:var(--primary-solid);font-size:50rpx;font-weight:850;transition:transform .1s}.num-btn:active{transform:scale(.95)}.size-4 .num-btn{height:134rpx;font-size:60rpx}.size-9 .num-btn{height:92rpx;font-size:43rpx}
.game-actions{width:100%;display:flex;gap:14rpx}.game-actions .submit-btn{flex:1;width:auto}.undo-btn{width:190rpx;height:98rpx;margin:0;border:1rpx solid rgba(255,255,255,.96);border-radius:28rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.96);box-shadow:var(--shadow-soft);color:var(--primary-solid);font-size:29rpx;font-weight:850;box-sizing:border-box}.undo-btn::after{border:0}.undo-btn[disabled]{background:rgba(255,255,255,.62);color:var(--text-faint);box-shadow:none}.undo-btn:active{transform:scale(.97)}
.modal-card{width:610rpx;padding:48rpx 40rpx 38rpx;border-radius:38rpx;display:flex;flex-direction:column;align-items:center;background:#fff;box-shadow:0 30rpx 80rpx rgba(43,33,55,.22);box-sizing:border-box}.result-badge{width:98rpx;height:98rpx;border-radius:31rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:38rpx;font-weight:900;margin-bottom:24rpx}.result-badge.success{background:linear-gradient(135deg,#4ec69a,#2fa97e);box-shadow:0 14rpx 30rpx rgba(47,169,126,.24)}.result-badge.complete{background:linear-gradient(135deg,var(--primary-from),var(--primary-to));font-size:29rpx}.checkmark{width:36rpx;height:20rpx;border-left:7rpx solid #fff;border-bottom:7rpx solid #fff;transform:rotate(-45deg) translate(2rpx,-3rpx);border-radius:2rpx}.modal-kicker{font-size:22rpx;color:var(--primary-solid);font-weight:800;letter-spacing:3rpx}.modal-title{font-size:39rpx;color:var(--text-main);font-weight:900;margin-top:10rpx}.result-time{font-size:56rpx;color:var(--text-main);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:850;margin:24rpx 0 2rpx}.modal-desc{font-size:24rpx;line-height:1.7;color:var(--text-muted);text-align:center;margin:18rpx 0 32rpx}.modal-btn{width:100%}

.game-container{padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}
.mode-label{font-size:24rpx}
.timer{min-height:68rpx;font-size:27rpx}
.modal-kicker{font-size:25rpx}
.modal-desc{font-size:27rpx}
.modal-card{width:calc(100vw - 64rpx);max-width:610rpx}
@media (max-width:360px){
  .game-container{padding-left:20rpx;padding-right:20rpx}
  .level-text{font-size:35rpx}
  .timer{min-width:142rpx}
  .num-btn{height:108rpx}
  .size-4 .num-btn{height:120rpx}
}

.game-container{width:100%;max-width:430px;padding-left:var(--page-gutter);padding-right:var(--page-gutter)}
.mode-label,.modal-kicker{font-size:var(--font-sm)}
.level-text,.modal-title{font-size:var(--font-xl)}
.timer,.modal-desc{font-size:var(--font-md)}
.start-game-btn,.submit-btn,.undo-btn,.modal-btn{font-size:var(--font-md)}
.result-badge,.result-badge.complete{font-size:var(--font-lg)}
.result-time{font-size:var(--font-xl)}
.result-time{display:flex;align-items:baseline;justify-content:center;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:0}
.result-time-dot{padding:0 2rpx}
.result-time-tenths{font-size:1em;font-weight:850}
.start-game-btn,.submit-btn,.undo-btn,.num-btn{min-height:var(--touch-min)}
.board-card,.grid,.numpad,.numpad-row{width:100%;min-width:0}
.modal-card{max-width:calc(100vw - var(--page-gutter) - var(--page-gutter))}
