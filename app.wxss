/* 数独小勇士 · 全局设计系统 */
page {
  --bg-from: #fff8fb;
  --bg-via: #fff6fa;
  --bg-to: #f8f6fb;
  --primary-from: #ef5da8;
  --primary-to: #f06c83;
  --primary-solid: #df3f8b;
  --primary-text: #b82369;
  --primary-shadow: rgba(223,63,139,.20);
  --card-bg: #ffffff;
  --surface-soft: #fff5f9;
  --surface-strong: #f9edf3;
  --text-main: #28232b;
  --text-muted: #817985;
  --text-faint: #aaa3ad;
  --border-color: #eadfe5;
  --grid-line: #e5dde2;
  --board-line: #554b53;
  --cell-bg: #ffffff;
  --cell-fixed: #fff8fa;
  --cell-empty: #ffffff;
  --cell-selected: #f9d5e7;
  --cell-highlight: #fff0f7;
  --cell-peer: #fbeaf2;
  --cell-same: #f4d8e5;
  --header-bg: #fff3f8;
  --error-color: #d94c5c;
  --error-bg: #fff0f1;
  --success-color: #2f9f75;
  --accent-soft: #f8cada;
  --secondary-soft: #ded7ef;
  --shadow-soft: 0 8rpx 26rpx rgba(50,37,48,.07);
  --shadow-card: 0 20rpx 54rpx rgba(50,37,48,.10);
}

.theme-normal {
  --bg-from:#fff8fb;--bg-via:#fff6fa;--bg-to:#f8f6fb;
  --primary-from:#ef5da8;--primary-to:#f06c83;--primary-solid:#df3f8b;--primary-text:#b82369;
  --primary-shadow:rgba(223,63,139,.20);--surface-soft:#fff5f9;--surface-strong:#f9edf3;
  --border-color:#eadfe5;--cell-fixed:#fff8fa;--cell-selected:#f9d5e7;--cell-highlight:#fff0f7;
  --cell-peer:#fbeaf2;--cell-same:#f4d8e5;--header-bg:#fff3f8;--accent-soft:#f8cada;--secondary-soft:#ded7ef;
  --grid-line:#e5dde2;--board-line:#554b53;
}

.theme-soft {
  --bg-from:#f7fcf9;--bg-via:#f3faf6;--bg-to:#f6f8f7;
  --primary-from:#45b985;--primary-to:#55c6a0;--primary-solid:#26986a;--primary-text:#187851;
  --primary-shadow:rgba(38,152,106,.18);--surface-soft:#f1faf5;--surface-strong:#e4f4eb;
  --border-color:#d8e9df;--cell-fixed:#f7fbf8;--cell-selected:#cdebdc;--cell-highlight:#eaf8f0;
  --cell-peer:#e6f5ed;--cell-same:#cfe9dc;--header-bg:#edf8f2;--accent-soft:#bfe8d2;--secondary-soft:#d9e8de;
  --grid-line:#dce8e1;--board-line:#4d6258;
}

.theme-eye-care {
  --bg-from:#fffcf4;--bg-via:#fbf8ed;--bg-to:#f8f6ef;
  --primary-from:#dfa937;--primary-to:#e8b755;--primary-solid:#c98a12;--primary-text:#9b670a;
  --primary-shadow:rgba(201,138,18,.17);--surface-soft:#fff9e9;--surface-strong:#f7edcf;
  --border-color:#e8dfc6;--cell-fixed:#fffdf7;--cell-selected:#f2dda1;--cell-highlight:#fff6d9;
  --cell-peer:#f9efd0;--cell-same:#ead9a8;--header-bg:#fff7df;--accent-soft:#eed49a;--secondary-soft:#e8e0c0;
  --grid-line:#e6dfcc;--board-line:#665d48;
}

.page-bg {
  min-height: 100vh;
  background: linear-gradient(160deg,var(--bg-from) 0%,var(--bg-via) 52%,var(--bg-to) 100%);
  color: var(--text-main);
}

button { font-family: inherit; }

.btn-primary,.btn-secondary,.btn-accent {
  min-height: 92rpx;
  border-radius: 26rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  transition: transform .12s ease,opacity .12s ease;
}
.btn-primary,.btn-accent {
  color:#fff;
  background:linear-gradient(135deg,var(--primary-from),var(--primary-to));
  box-shadow:0 12rpx 28rpx var(--primary-shadow);
}
.btn-secondary {
  color:var(--text-main);
  background:rgba(255,255,255,.94);
  border:1rpx solid var(--border-color);
  box-shadow:var(--shadow-soft);
}
.btn-primary::after,.btn-secondary::after,.btn-accent::after { border:0; }
.btn-primary:active,.btn-secondary:active,.btn-accent:active { transform:scale(.97);opacity:.9; }

.card {
  padding:32rpx;
  border-radius:32rpx;
  background:rgba(255,255,255,.94);
  border:1rpx solid rgba(255,255,255,.9);
  box-shadow:var(--shadow-soft);
}

.mask {
  position:fixed;inset:0;z-index:999;
  display:flex;align-items:center;justify-content:center;
  padding:36rpx;box-sizing:border-box;
  background:rgba(31,25,32,.48);
  backdrop-filter:blur(8rpx);
}

.text-primary { color:var(--primary-text); }
.text-bold { font-weight:800; }

@keyframes pop { from{transform:translateY(24rpx) scale(.96);opacity:0} to{transform:none;opacity:1} }
.animate-pop { animation:pop .24s ease-out; }
@keyframes spin { to{transform:rotate(360deg)} }

view,text,image,input,button,scroll-view{box-sizing:border-box}
.root{width:100%;min-height:100vh;overflow-x:hidden}
